      "deceleration": "decel", "cut": "cut", "cutting": "cut", "agility": "cut",
      "reactive": "reactive"
    },
    "session_tags": {
      "upperA": "upper", "upperB": "upper", "accessory": "accessory", "arms": "accessory", "power": "power"
    }
  },
