{
  "_about": "Translation rules: real deeds -> XP and temper (attribute growth). Edit numbers here, never in code. After any change run: python3 engine/darrow.py sync",
  "levels": {
    "_formula": "XP to reach level L = 50 * L * (L - 1)",
    "ranks": [
      {"from": 1,  "name": "Bound"},
      {"from": 5,  "name": "Kindled"},
      {"from": 10, "name": "Tempered"},
      {"from": 15, "name": "Warden-Errant"},
      {"from": 20, "name": "Emberknight"},
      {"from": 25, "name": "Unbowed"},
      {"from": 30, "name": "Warden of the Ember"}
    ]
  },
  "attributes": {
    "_formula": "score = base + floor(sqrt(temper / divisor)), then capped by the Knots of the Binding",
    "might":   {"base": 9, "divisor": 3, "fell": 15},
    "vigor":   {"base": 8, "divisor": 2, "fell": 15},
    "finesse": {"base": 7, "divisor": 2, "fell": 18},
    "resolve": {"base": 8, "divisor": 4, "fell": 12}
  },
  "caps_by_knots": {
    "_about": "Highest score an attribute can show for a given number of Knots tied. Temper earned above the cap is banked and released when the next Knot ties.",
    "vigor":   {"0": 12, "1": 12, "2": 12, "3": 14, "4": 18, "5": 30, "6": 30, "7": 30},
    "finesse": {"0": 10, "1": 10, "2": 10, "3": 12, "4": 14, "5": 18, "6": 22, "7": 30}
  },
  "daily": {
    "floor_full":        {"xp": 10, "temper": {"resolve": 1}, "label": "Floor minimum, AM and PM"},
    "floor_half":        {"xp": 5,  "temper": {},              "label": "Floor minimum, one round"},
    "morning_check":     {"xp": 5,  "temper": {"resolve": 1}, "label": "Morning knee check, swelling graded"},
    "knee_session":      {"xp": 30, "temper": {"might": 2, "finesse": 1}, "label": "Knee session"},
    "knee_as_planned":   {"xp": 0,  "temper": {"resolve": 1}, "label": "Knee session run as written"},
    "pt_visit":          {"xp": 30, "temper": {"might": 1, "finesse": 1}, "label": "PT visit"},
    "upper_session":     {"xp": 25, "temper": {"might": 2}, "label": "Upper-body session"},
    "accessory_session": {"xp": 15, "temper": {"might": 1}, "label": "Accessory day"},
    "power_session":     {"xp": 20, "temper": {"might": 1, "finesse": 1}, "label": "Power & mobility"},
    "conditioning":      {"xp_per_min": 0.5, "xp_cap": 30, "min_minutes": 10, "temper_per_10_min": {"vigor": 1}, "temper_cap": 4, "label": "Conditioning"},
    "sport_session":     {"xp": 25, "temper": {"finesse": 2, "vigor": 1}, "per_day_cap": 2, "label": "Sport skill session"},
    "weigh_in":          {"xp": 10, "temper": {}, "label": "Morning weigh-in"},
    "creatine":          {"xp": 5,  "temper": {}, "label": "Creatine"},
    "kcal_hit":          {"xp": 20, "temper": {}, "label": "Calorie target reached"},
    "kcal_near":         {"xp": 10, "threshold": 0.92, "temper": {}, "label": "Calories within 8% of target"},
    "protein_hit":       {"xp": 20, "temper": {}, "label": "Protein target reached"},
    "protein_near":      {"xp": 10, "threshold": 0.90, "temper": {}, "label": "Protein within 10% of target"},
    "day_closed":        {"xp": 5,  "temper": {}, "label": "Day closed"}
  },
  "weekly": {
    "floor_7_of_7":      {"xp": 40, "temper": {"resolve": 2}, "inspiration": 1, "label": "Floor minimum every day of the week"},
    "scouted":           {"xp": 25, "min_weighins": 3, "label": "3+ weigh-ins this week"},
    "all_sessions":      {"xp": 50, "temper": {"resolve": 1}, "label": "Every planned session done"},
    "tier_bonus":        {"Triumph": 60, "Hard-won": 30, "Costly": 0, "Setback": 0},
    "triumph_inspiration": 1
  },
  "week_score": {
    "_about": "0-100. Sets the chapter's outcome tier. Red-light days (plan says rest) are excused, not counted against.",
    "weights": {"floor": 20, "sessions": 25, "fuel": 30, "checks": 10, "weighins": 5, "ledger": 10},
    "tiers": [
      {"min": 85, "name": "Triumph",  "roll_mod": 3},
      {"min": 70, "name": "Hard-won", "roll_mod": 1},
      {"min": 50, "name": "Costly",   "roll_mod": 0},
      {"min": 0,  "name": "Setback",  "roll_mod": -2}
    ]
  },
  "ember": {
    "_about": "Rolling 7-day fuel score, 0-100, from logged days only. Day fuel = kcal_weight*(kcal/target)^exp + protein_weight*(protein/target)^exp, each ratio capped at 1.",
    "kcal_weight": 0.55, "protein_weight": 0.45, "exponent": 2,
    "tiers": [
      {"min": 95, "name": "Blazing",   "effect": "+1 to every check"},
      {"min": 85, "name": "Bright",    "effect": "+1 to Vigor checks"},
      {"min": 70, "name": "Steady",    "effect": "none"},
      {"min": 50, "name": "Low",       "effect": "none; the cold gets in"},
      {"min": 0,  "name": "Guttering", "effect": "-1 to Might and Vigor checks"}
    ]
  },
  "inspiration": {"cap": 4},
  "hp": {"_formula": "20 + 4*level + 2*(vigor - 10), minimum 10"},
  "tags": {
