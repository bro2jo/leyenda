{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 engine/darrow.py *)",
      "Bash(python3 engine/saga.py *)",
      "Bash(python3 engine/build_site.py *)",
      "Bash(python3 engine/build_site.py)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Edit(/real/**)",
      "Edit(/saga/**)"
    ],
    "deny": [
      "Read(/docs/**)",
      "Edit(/engine/deeds.csv)",
      "Edit(/saga/state/darrow.json)",
      "Edit(/real/plan/rehab_master_plan.md)",
      "Edit(/real/plan/offseason_program_24_week.md)",
      "Edit(/real/plan/ultimate_offseason_guide.md)",
      "Edit(/real/plan/nutrition_guide.md)",
      "Edit(/real/logs/archive/*.csv)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
